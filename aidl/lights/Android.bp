rust_binary {
    name: "android.hardware.lights-service.salaa",
    relative_install_path: "hw",
    init_rc: ["android.hardware.lights-service.salaa.rc"],
    vintf_fragments: ["android.hardware.lights-service.salaa.xml"],
    vendor: true,
    rustlibs: [
        "liblogger",
        "liblog_rust",
        "libbinder_rs",
        "android.hardware.light-V2-rust",
    ],
    srcs: ["main.rs"],
}
