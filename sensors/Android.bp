cc_library_shared {
    name: "sensors.oplus_virtual",
    defaults: ["hidl_defaults"],
    vendor: true,
    srcs: [
        "oplus_virtual_sensors.cpp",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libutils",
    ],
    header_libs: [
        "libhardware_headers",
        "generated_kernel_headers",
    ],
}
