<resources>
    <!-- Disable dial pad tones by default -->
    <bool name="def_dtmf_tones_enabled">false</bool>

    <!-- Enable vibrate for calls by default -->
    <bool name="def_vibrate_when_ringing">true</bool>

    <!-- Disable UI touch sounds by default -->
    <bool name="def_sound_effects_enabled">false</bool>

    <!-- Set the automatic brightness mode on by default -->
    <bool name="def_screen_brightness_automatic_mode">true</bool>

    <!-- Set Window animation scale to 100% by default -->
    <fraction name="def_window_animation_scale">65%</fraction>

    <!-- Set Window transition scale to 100% by default -->
    <fraction name="def_window_transition_scale">65%</fraction>
</resources>
